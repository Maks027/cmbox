{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "cmake --build --preset debug --target flash",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": []
    }
  ]
}
